{
  "manifest_version": 3,
  "name": "YTM Beacon",
  "version": "__VERSION__",
  "description": "Shows what you're playing on YouTube Music as your Discord status. Needs the YTM Beacon app running on this computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YTM Beacon",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-presence": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Stop or resume showing on Discord"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://music.youtube.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "ytm-beacon@users.noreply.github.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
